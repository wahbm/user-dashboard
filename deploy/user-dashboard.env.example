# Install this file as /var/www/ww/user-dashboard/shared/app.env on ECS.
# Replace CHANGE_ME_DB_PASSWORD only on the server. Never commit the populated file.
NODE_ENV=production
PORT=3100

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=user_dashboard
DB_USER=user_dashboard_app
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_CONNECTION_LIMIT=10

TOKEN_TTL_SECONDS=86400
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=123456
CLIENT_ORIGIN=http://8.130.116.192
